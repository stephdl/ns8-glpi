import os
import sys
import json
import agent

data = json.load(sys.stdin)

# glpi-apply-config removes the file only after GLPI accepted the password
if data.get("admin_password") and not os.path.exists("secrets/admin_password"):
    agent.set_env("ADMIN_PASSWORD_SET", True)
