set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# A running container keeps its old HTTPS cookie setting until restarted
running=$(podman inspect glpi-app --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^GLPI_COOKIE_SECURE=//p')
if [[ -n "${running}" && "${running}" != "${TRAEFIK_HTTP2HTTPS}" ]]; then
    systemctl --user restart glpi-app.service
fi

systemctl --user enable glpi.service
systemctl --user start glpi.service mariadb-app.service glpi-app.service

if [[ "${LDAP_SYNC}" == "True" ]]; then
    systemctl --user enable --now glpi-ldap-sync.timer
else
    systemctl --user disable --now glpi-ldap-sync.timer
fi

runagent glpi-apply-config
