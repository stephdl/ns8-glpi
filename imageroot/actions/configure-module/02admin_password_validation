import os
import sys
import json
import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

# Without a first password the GLPI default glpi/glpi account stays open
if not data.get("admin_password") and os.getenv("ADMIN_PASSWORD_SET") != "True":
    agent.set_status('validation-failed')
    json.dump([{'field': 'admin_password', 'parameter': 'admin_password', 'value': '', 'error': 'admin_password_required'}], fp=sys.stdout)
    sys.exit(2)
