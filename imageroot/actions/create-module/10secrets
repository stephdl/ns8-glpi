import os
import secrets

os.makedirs("secrets", mode=0o700, exist_ok=True)

root_password = secrets.token_urlsafe(32)
glpi_password = secrets.token_urlsafe(32)

def write_secret(path, lines):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write("\n".join(lines) + "\n")

write_secret("secrets/mariadb.env", [
    f"MARIADB_ROOT_PASSWORD={root_password}",
    f"MARIADB_PASSWORD={glpi_password}",
])
write_secret("secrets/glpi.env", [
    f"GLPI_DB_PASSWORD={glpi_password}",
])
