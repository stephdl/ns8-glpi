[Unit]
Description=Synchronize GLPI users with the NS8 user domain
Requisite=glpi-app.service
After=glpi-app.service

[Service]
Type=oneshot
SyslogIdentifier=%N
ExecStart=/usr/bin/podman exec glpi-app php /var/www/glpi/bin/console ldap:synchronize_users --no-interaction
